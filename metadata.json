<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>DON AZA-KHEM | Quiet Luxury</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root{--gold:#C9A86A;--black:#0A0A0A;--cream:#FCFBF8}
  *{box-sizing:border-box}
  body{margin:0;background:var(--cream);color:var(--black);font-family:'Inter',sans-serif}
  
  /* PREMIUM HEADER */
  header{background:var(--black);padding:28px 20px;text-align:center;position:sticky;top:0;z-index:10}
  header h1{color:var(--cream);font-family:'Cormorant Garamond',serif;font-weight:300;font-size:22px;letter-spacing:.5em;margin:0}
  header p{color:var(--gold);font-size:10px;letter-spacing:.4em;margin:8px 0 0;text-transform:uppercase}
  
  /* HERO - EDITORIAL */
  .hero{background:var(--black);color:var(--cream);text-align:center;padding:60px 20px 80px}
  .hero h2{font-family:'Cormorant Garamond',serif;font-weight:300;font-size:52px;margin:0;line-height:0.9;letter-spacing:-.02em}
  .hero h2 em{font-style:italic;color:var(--gold);font-weight:300}
  .hero .sub{margin-top:20px;color:#888;font-size:11px;letter-spacing:.35em;text-transform:uppercase}
  .hero .line{width:40px;height:1px;background:var(--gold);margin:24px auto 0}

  /* GRID */
  .grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:1px;background:#e8e3d9;max-width:1200px;margin:-40px auto 0;border:1px solid #e8e3d9}
  @media(max-width:900px){.grid{grid-template-columns:1fr 1fr;margin:-20px 20px 0}}
  @media(max-width:600px){.grid{grid-template-columns:1fr}}
  .card{background:white;padding:0;position:relative}
  .card img{width:100%;height:600px;object-fit:cover;display:block;transition:.6s}
  .card:hover img{transform:scale(1.02)}
  .card-top{display:flex;justify-content:space-between;align-items:center;padding:18px 20px 0}
  .badge{font-size:9px;letter-spacing:.2em;background:var(--black);color:white;padding:6px 10px;border-radius:99px}
  .price{font-family:'Cormorant Garamond',serif;font-size:18px}
  .card-body{padding:14px 22px 28px}
  .card-body h3{font-family:'Cormorant Garamond',serif;font-size:22px;font-weight:400;margin:0;letter-spacing:.02em}
  .card-body .meta{font-size:10px;letter-spacing:.2em;color:#999;margin:6px 0 18px;text-transform:uppercase}
  .btn{display:flex;justify-content:space-between;align-items:center;background:var(--black);color:white;padding:14px 18px;text-decoration:none;font-size:10px;letter-spacing:.25em;border-radius:0;transition:.3s;border:1px solid var(--black)}
  .btn span:last-child{color:var(--gold)}
  .btn:hover{background:white;color:var(--black)}

  /* FOOTER LUXURY */
  footer{background:var(--black);color:#666;text-align:center;padding:60px 20px;font-size:10px;letter-spacing:.3em;line-height:2}
  footer b{color:var(--cream);font-weight:400;letter-spacing:.4em;font-size:12px}
  footer .gold{color:var(--gold)}
</style>
</head>
<body>

<header>
  <h1>DON AZA-KHEM</h1>
  <p>Cape Town • Est. 2025</p>
</header>

<div class="hero">
  <h2>Quiet <em>Luxury</em></h2>
  <div class="sub">Satin Finish • Gold Cross • French Cuffs</div>
  <div class="line"></div>
</div>

<div class="grid">
  <div class="card">
    <div class="card-top"><span class="badge">BEST SELLER</span><span class="price">R599</span></div>
    <img src="navy_shirt_real.jpg" alt="Navy" />
    <div class="card-body">
      <h3>Navy Signature</h3>
      <div class="meta">Deep Navy • S-XXL • COD Available</div>
      <a class="btn" href="https://wa.me/27736285307?text=Hi%20DON%20AZA-KHEM%20-%20I%20want%20Navy%20Signature%20R599%20Size%3A"><span>ACQUIRE ON WHATSAPP</span><span>→</span></a>
    </div>
  </div>
  <div class="card">
    <div class="card-top"><span class="badge">LIMITED</span><span class="price">R599</span></div>
    <img src="burgundy_shirt_real.jpg" alt="Burgundy" />
    <div class="card-body">
      <h3>Burgundy Signature</h3>
      <div class="meta">Rich Burgundy • S-XXL • Limited Run</div>
      <a class="btn" href="https://wa.me/27736285307?text=Hi%20DON%20AZA-KHEM%20-%20I%20want%20Burgundy%20Signature%20R599%20Size%3A"><span>ACQUIRE ON WHATSAPP</span><span>→</span></a>
    </div>
  </div>
  <div class="card">
    <div class="card-top"><span class="badge">NEW</span><span class="price">R599</span></div>
    <img src="black_shirt_real.jpg" alt="Black" />
    <div class="card-body">
      <h3>Noir Signature</h3>
      <div class="meta">Jet Black • French Cuff • Gold Cross</div>
      <a class="btn" href="https://wa.me/27736285307?text=Hi%20DON%20AZA-KHEM%20-%20I%20want%20Black%20Noir%20Signature%20R599%20Size%3A"><span>ACQUIRE ON WHATSAPP</span><span>→</span></a>
    </div>
  </div>
</div>

<footer>
  <b>DON AZA-KHEM</b><br/>
  QUIET LUXURY CAPE TOWN<br/><br/>
  <span class="gold">WHATSAPP 073 628 5307</span><br/>
  CASH ON DELIVERY • PAXI NATIONWIDE<br/>
  S — M — L — XL — XXL
</footer>

</body>
</html>